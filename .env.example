# Base de données (docker compose up -d → port 5433 côté hôte)
DATABASE_URL="postgresql://dispo:dispo@localhost:5433/dispo?schema=public"

# Auth.js — générer avec : npx auth secret
AUTH_SECRET=""

# Production hors Vercel (serveur de l'école, `next start` en local) : sans
# cette ligne, Auth.js refuse toutes les connexions (erreur « UntrustedHost »).
# Sur Vercel, inutile : l'hébergeur est reconnu automatiquement.
# Alternative plus stricte : AUTH_URL="https://adresse-publique-du-site"
# AUTH_TRUST_HOST=true

# Google OAuth (console.cloud.google.com)
# Redirect URI de dev : http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Domaines autorisés pour la connexion Google (séparés par des virgules)
# Personnel uniquement : les étudiants (@etu.he2b.be) n'ont pas accès.
ALLOWED_EMAIL_DOMAINS="he2b.be"

# Compte admin créé par le seed
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="changeme"
