// Schéma de données — voir SPEC.md §5.
//
// Deux invariants à ne pas casser :
//  1. Les créneaux ne sont PAS persistés. Ils sont dérivés de Calendar
//     (horaires, durée, pauses, jours fériés). Il n'y a pas de table Slot.
//  2. Availability ne contient QUE des exceptions. Un créneau sans ligne vaut
//     AVAILABLE. Repasser à « disponible » supprime la ligne.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 : l'URL de connexion ne vit plus ici. Migrate la lit dans
// prisma.config.ts, et PrismaClient la reçoit via un adapter.
datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ResourceType {
  PERSON
  LOCAL
  EQUIPMENT
}

enum AvailabilityStatus {
  AVAILABLE // jamais écrit en base — voir SPEC §7
  UNAVAILABLE
  IF_NEEDED
}

model User {
  id   String @id @default(cuid())
  role Role   @default(USER) // découle du provider de connexion

  // Voie Google (personnel HE2B). Le compte est créé par l'admin (import de la
  // liste du personnel ou ajout à la main) : seule une adresse déjà en base
  // peut se connecter.
  email       String?   @unique
  disabledAt  DateTime? // accès coupé par l'admin, qui peut le rétablir ; null = accès ouvert
  lastLoginAt DateTime? // dernière connexion Google ; null = jamais connecté

  // Voie identifiant / mot de passe (admin, créé par seed)
  username     String? @unique
  passwordHash String?
  // Protection contre la force brute : 5 échecs → compte verrouillé 15 min.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?

  name      String?
  createdAt DateTime @default(now())

  // Un ADMIN n'a pas de fiche : c'est ce qui l'empêche de saisir « ses » dispos.
  resource             Resource?
  editedAvailabilities Availability[] @relation("EditedBy")
}

model Calendar {
  id String @id @default(cuid())

  // Configuration saisie par l'admin — source de vérité unique de la grille
  name         String
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date // 15 semaines maximum — voir SPEC §6
  weekDays     String[] // ["monday", "tuesday", ...]
  dayStart     String // "08:00"
  dayEnd       String // "18:00"
  slotDuration Int // en minutes
  slotGap      Int      @default(0) // intercours entre deux créneaux, en minutes

  publishedAt DateTime? // null = brouillon, invisible des USER
  lockedAt    DateTime? // saisie clôturée par l'admin : le personnel ne peut plus rien modifier
  createdAt   DateTime  @default(now())

  breaks         Break[]
  holidays       Holiday[]
  availabilities Availability[]
}

model Break {
  id String @id @default(cuid())

  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  name  String // "Pause déjeuner"
  start String // "12:00"
  end   String // "14:00"

  @@unique([calendarId, start])
}

model Holiday {
  id String @id @default(cuid())

  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  date  DateTime @db.Date
  label String? // "Congé d'automne", "Armistice"

  @@unique([calendarId, date])
}

model Resource {
  id   String       @id @default(cuid())
  type ResourceType
  name String // PERSON : copie de User.name, resynchronisée à chaque connexion (src/auth.ts)

  ownerId String? @unique // rempli uniquement pour une PERSON
  owner   User?   @relation(fields: [ownerId], references: [id])

  // Propre aux LOCAL, vide pour une personne ou un équipement (contrainte CHECK
  // ajoutée dans la migration room_details, et validation applicative).
  capacity   Int? // nombre de places
  building   String? // texte libre : « Bâtiment B », « Campus Anderlecht »
  roomTypeId String?
  roomType   RoomType?         @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  features   ResourceFeature[]

  availabilities Availability[]

  // Pas d'unicité : deux membres du personnel peuvent porter le même nom.
  // L'import XLS retrouve un local ou un équipement par (type, name).
  @@index([type, name])
}

// Types de local (Auditoire, Salle de cours, Labo informatique…). Liste gérée
// par l'admin, complétée à la volée par le formulaire et l'import.
// Un type utilisé ne se supprime pas (onDelete: Restrict).
model RoomType {
  id        String     @id @default(cuid())
  name      String     @unique // comparé sans tenir compte de la casse par l'application
  resources Resource[]
}

// Caractéristiques fixes d'un local (Projecteur, PC, Accès PMR…). Ce ne sont
// pas des ressources : elles n'ont pas de disponibilités, elles sont
// disponibles quand le local l'est. Ce qui se déplace ou se réserve à part
// est une Resource EQUIPMENT.
model Feature {
  id        String            @id @default(cuid())
  name      String            @unique // comparé sans tenir compte de la casse par l'application
  resources ResourceFeature[]
}

// Caractéristique d'un local, avec sa quantité (« PC × 30 »).
model ResourceFeature {
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  featureId  String
  feature    Feature  @relation(fields: [featureId], references: [id], onDelete: Restrict)
  quantity   Int      @default(1)

  @@id([resourceId, featureId])
}

model Availability {
  id String @id @default(cuid())

  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  date  DateTime @db.Date // le jour concerné
  start String // "08:00" — la tranche, interprétée via slotDuration

  status  AvailabilityStatus // UNAVAILABLE ou IF_NEEDED uniquement
  comment String // toujours renseigné : une ligne = une exception justifiée

  updatedById String
  updatedBy   User     @relation("EditedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt

  // Un seul statut par calendrier × ressource × jour × tranche : deux calendriers
  // qui se chevauchent (une conférence pendant un quadrimestre) ont chacun le leur.
  @@unique([calendarId, resourceId, date, start])
}
